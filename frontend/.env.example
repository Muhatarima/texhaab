# texHAAB Frontend Environment Configuration
# When running locally, points to the local FastAPI server
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# When deployed to Vercel, set this in your Vercel Project Settings > Environment Variables:
# NEXT_PUBLIC_API_URL=https://<your-backend-subdomain>.hf.space
# or
# NEXT_PUBLIC_API_URL=https://<your-backend-app>.onrender.com
